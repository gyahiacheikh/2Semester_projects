        <rdfs:label>B2a_Stop_Octagonal</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B2b_Stop_Circular">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#B2_Stop"/>
        <rdfs:label>B2b_Stop_Circular</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B3_PriorityRoad">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#PrioritySign"/>
        <rdfs:label>B3_PriorityRoad</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B4_EndOfPriority">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#PrioritySign"/>
        <rdfs:label>B4_EndOfPriority</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B5_PriorityForOncomingTraffic">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#PrioritySign"/>
        <rdfs:label>B5_PriorityForOncomingTraffic</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B6_PriorityOverOncomingTraffic">
