        <rdfs:label>C1b_NoEntry_Circular</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#C2_ClosedToAllVehicles">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#ProhibitorySign"/>
        <rdfs:label>C2_ClosedToAllVehicles</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#C3a_NoPowerDrivenVehiclesExceptTwoWheeledMotorcycles">
