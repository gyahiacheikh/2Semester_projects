    </owl:Class>
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#C1a_NoEntry_Rectangular">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#C1_NoEntry"/>
        <rdfs:label>C1a_NoEntry_Rectangular</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#C1b_NoEntry_Circular">
