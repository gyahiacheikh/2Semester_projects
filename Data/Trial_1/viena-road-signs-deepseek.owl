<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
     
    <owl:Ontology rdf:about="http://www.w3.org/2002/07/owl">
        <rdfs:comment>OWL2 Taxonomy of Road Signs based on the Vienna Convention on Road Signs and Signals, Part I, Annex 1</rdfs:comment>
    </owl:Ontology>

    <!-- Root Class -->
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#RoadSign">
        <rdfs:label>RoadSign</rdfs:label>
    </owl:Class>

    <!-- Top Level Categories -->
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#DangerWarningSign">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#RoadSign"/>
        <rdfs:label>DangerWarningSign</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#RegulatorySign">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#RoadSign"/>
        <rdfs:label>RegulatorySign</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#InformativeSign">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#RoadSign"/>
        <rdfs:label>InformativeSign</rdfs:label>
    </owl:Class>

    <!-- Disjointness Axioms for Top Level Categories -->
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#DangerWarningSign">
        <owl:disjointWith rdf:resource="http://www.w3.org/2002/07/owl#RegulatorySign"/>
        <owl:disjointWith rdf:resource="http://www.w3.org/2002/07/owl#InformativeSign"/>
    </owl:Class>
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#RegulatorySign">
        <owl:disjointWith rdf:resource="http://www.w3.org/2002/07/owl#InformativeSign"/>
    </owl:Class>

    <!-- ==================== REGULATORY SIGN SUBCLASSES ==================== -->
    
    <!-- Priority Signs -->
    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#PrioritySign">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#RegulatorySign"/>
        <rdfs:label>PrioritySign</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B1_GiveWay">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#PrioritySign"/>
        <rdfs:label>B1_GiveWay</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B2_Stop">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#PrioritySign"/>
        <rdfs:label>B2_Stop</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://www.w3.org/2002/07/owl#B2a_Stop_Octagonal">
