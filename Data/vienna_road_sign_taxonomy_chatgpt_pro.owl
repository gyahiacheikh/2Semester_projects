  <owl:Ontology rdf:about="http://example.org/vienna-road-sign-taxonomy">
    <rdfs:comment xml:lang="en">OWL2 class taxonomy of road signs based on Part I, Annex 1, of the Vienna Convention on Road Signs and Signals. Contains classes, subclass axioms, labels, comments, and disjointness axioms only.</rdfs:comment>
  </owl:Ontology>
  <owl:Class rdf:about="#RoadSign">
