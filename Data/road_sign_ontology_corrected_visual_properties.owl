    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DangerWarningSign"/>
    <rdfs:label>Cyclists entering or crossing sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#LightSignalsSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DangerWarningSign"/>
    <rdfs:label>Light signals sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#HotelOrMotelSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#InformationFacilitiesOrServiceSign"/>
    <rdfs:label>HOTEL or MOTEL sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#NoUTurnsSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#ProhibitoryOrRestrictiveSign"/>
    <rdfs:label>NO U-TURNS sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#SignBackground">
    <rdfs:comment>A conceptual class representing the background area or face of a road sign.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#VisualElement"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#NoEntryForVehiclesExceedingOverallHeightSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#ProhibitoryOrRestrictiveSign"/>
    <rdfs:label>NO ENTRY FOR VEHICLES HAVING AN OVERALL HEIGHT EXCEEDING ... METRES sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#RoundaboutWarningSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DangerWarningSign"/>
    <rdfs:label>Roundabout warning sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#NoEntryForPowerDrivenAgriculturalVehiclesSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#ProhibitoryOrRestrictiveSign"/>
    <rdfs:label>NO ENTRY FOR POWER DRIVEN AGRICULTURAL VEHICLES sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#IndicationSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DirectionPositionOrIndicationSign"/>
    <rdfs:label>Indication sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#DirectionToBeFollowedSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#MandatorySign"/>
    <rdfs:label>DIRECTION TO BE FOLLOWED sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#Color">
    <rdfs:comment>A conceptual class representing colours used in the visual design of road signs, such as red, blue, white, yellow, black, or green.</rdfs:comment>
    <rdfs:comment>Added as a supporting conceptual range class for object properties such as hasBackgroundColor, hasBorderColor, and hasSymbolColor; literal colour names are represented separately using datatype properties.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#CarriagewayNarrowsSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DangerWarningSign"/>
    <rdfs:label>Carriageway narrows sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#RoadForMotorVehiclesSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#SpecialRegulationSign"/>
    <rdfs:label>ROAD FOR MOTOR VEHICLES sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#ParkingProhibitedSign">
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#ProhibitoryOrRestrictiveSign"/>
    <rdfs:label>PARKING PROHIBITED sign</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#Destination">
    <rdfs:comment>Conceptual class for destinations, places, routes, or named locations indicated by direction signs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/vienna-road-signs#Obligation">
    <rdfs:comment>Conceptual class for required movements, duties, or behaviours expressed by mandatory signs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#TrafficRegulation"/>
  </owl:Class>
</rdf:RDF>
