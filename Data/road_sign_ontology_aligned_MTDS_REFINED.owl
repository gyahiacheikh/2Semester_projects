<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/vienna-road-signs#"
     xml:base="http://example.org/vienna-road-signs"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://example.org/vienna-road-signs">
        <rdfs:comment>Aligned version: existing Vienna road-sign hierarchy extended with MTDS dataset classes, subclass axioms, and conservative exact owl:equivalentClass mappings.</rdfs:comment>
        <rdfs:comment>Refined MTDS alignment: MTDS dataset classes are connected to the road-sign hierarchy. owl:equivalentClass is reserved for one-to-one, high-confidence semantic matches; dataset-specific visual variants are mapped with rdfs:subClassOf to avoid over-strong logical equivalence.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/vienna-road-signs#AdditionalPanel -->

    <owl:Class rdf:about="http://example.org/vienna-road-signs#AdditionalPanel">
        <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#InformativeSign"/>
        <rdfs:label>Additional panel</rdfs:label>
    </owl:Class>
    


    <!-- http://example.org/vienna-road-signs#AdvanceDirectionSign -->

    <owl:Class rdf:about="http://example.org/vienna-road-signs#AdvanceDirectionSign">
        <rdfs:subClassOf rdf:resource="http://example.org/vienna-road-signs#DirectionPositionOrIndicationSign"/>
        <rdfs:label>Advance direction sign</rdfs:label>
    </owl:Class>
    


